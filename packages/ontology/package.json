{
  "name": "@citadel/ontology",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entities": {
      "types": "./dist/entities.d.ts",
      "import": "./dist/entities.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./assertions": {
      "types": "./dist/assertions.d.ts",
      "import": "./dist/assertions.js"
    },
    "./derived": {
      "types": "./dist/derived.d.ts",
      "import": "./dist/derived.js"
    },
    "./operational": {
      "types": "./dist/operational.d.ts",
      "import": "./dist/operational.js"
    },
    "./access": {
      "types": "./dist/access.d.ts",
      "import": "./dist/access.js"
    },
    "./relationships": {
      "types": "./dist/relationships.d.ts",
      "import": "./dist/relationships.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@citadel/config-typescript": "workspace:*",
    "typescript": "^5.5.3"
  }
}
